# BizClone environment configuration
#
# Copy this file to the REPOSITORY ROOT as .env:
#     cp .env.example .env
#
# backend/app/config/settings.py loads env_file="../.env", so the file must
# live at the repo root, not inside backend/.
# Every variable below is read by the application.

# ==============================
# Application Settings
# ==============================
APP_NAME=BizClone
APP_VERSION=1.0.0
ENVIRONMENT=development
DEBUG=True
LOG_LEVEL=INFO

# ==============================
# Server Configuration
# ==============================
HOST=0.0.0.0
PORT=8000

# ==============================
# Database (PostgreSQL)
# ==============================
# Matches the credentials in docker-compose.yml
DATABASE_URL=postgresql://bizclone_user:bizclone_pass@localhost:5432/bizclone_db
DB_ECHO=False
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# ==============================
# Redis
# ==============================
REDIS_URL=redis://localhost:6379/0

# ==============================
# Celery
# ==============================
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# ==============================
# AI Models
# ==============================

# Groq (intent classification)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# OpenAI (entity extraction, response generation)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# Whisper (speech-to-text, runs locally; needs the ffmpeg binary on PATH)
WHISPER_MODEL=base
WHISPER_DEVICE=cpu
WHISPER_LANGUAGE=en

# ==============================
# Business Settings
# ==============================
BUSINESS_NAME=BizClone Plumbing Services
BUSINESS_PHONE=+10000000000
BUSINESS_EMAIL=contact@example.com

BUSINESS_HOURS_START=08:00
BUSINESS_HOURS_END=18:00
BUSINESS_TIMEZONE=Europe/Berlin

# ==============================
# Scheduling
# ==============================
APPOINTMENT_DURATION_MINUTES=60
APPOINTMENT_BUFFER_MINUTES=15
MAX_DAILY_APPOINTMENTS=8

# ==============================
# Google Calendar Integration
# ==============================
# Optional: leave GOOGLE_CREDENTIALS_FILE empty to skip calendar sync.
# Path to the service-account JSON credentials file.
GOOGLE_CREDENTIALS_FILE=./credentials/google_calendar.json

# Calendar the events are written to.
GOOGLE_TARGET_CALENDAR=your_calendar_id@group.calendar.google.com

# ==============================
# Emergency Escalation
# ==============================
EMERGENCY_EMAIL=emergency@example.com
EMERGENCY_PHONE=+10000000000
EMERGENCY_KEYWORDS=leak,flooding,burst,emergency,urgent,water everywhere

# ==============================
# File Storage
# ==============================
RECORDINGS_DIR=./data/recordings

# ==============================
# Security
# ==============================
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000
